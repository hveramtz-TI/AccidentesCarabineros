# Compose interpolation file for LOCAL development. Copy to .env and fill in.
# Never commit .env. Development and production must use DIFFERENT token values.
#
# UUID_CONNECTION: backend expected Bearer token AND frontend build arg
# (compose passes it to the frontend as VITE_UUID_CONNECTION). The frontend
# and backend values must match within the environment.
UUID_CONNECTION=change-me-local-dev-token

# Public frontend build inputs (Vite embeds them in the bundle).
VITE_API_BASE_URL=http://localhost:8080

# Comma-separated browser origins allowed by the backend CORS guard.
CORS_ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5173
