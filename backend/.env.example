# Copy to .env and fill in real credentials. Never commit .env.
# Single URL, read by both the API and the startup `prisma migrate deploy`.
# In Fly this must be the Neon DIRECT (non-pooled) URL; Compose overrides it locally.
DATABASE_NEON_URL="postgresql://USER:PASSWORD@localhost:5432/accidentes?schema=public"
# Basic Bearer request barrier (NOT authentication). Must equal the
# frontend VITE_UUID_CONNECTION of the same environment. Compose reads it
# from the repo-root .env; keep real values out of Git.
UUID_CONNECTION=
# Comma-separated browser origins allowed by CORS (local defaults).
CORS_ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5173

