{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:check": "node --env-file=.env --import tsx src/db/check-connection.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import": "cd .. && node backend/dist/import/cli.js",
    "test": "node --import tsx --test src/import/*.test.ts src/services/dashboard-service.test.ts src/routes/dashboard.test.ts src/routes/dashboard-auth.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
